{
  "name": "@taifoon/jev-wilson",
  "version": "0.3.1",
  "description": "Price agent jobs settled through an evaluator: the fee that never loses (max of bps and our gas at the quoted price), the cover premium from a seller's record (Wilson bound, or the pool holder's Beta-Binomial price), and a one-command calibration per chain. TypeScript and Python, bit for bit. Optional grading with TypeSafe's Jev.",
  "license": "Apache-2.0",
  "author": "Taifoon <taifooon@proton.me>",
  "homepage": "https://github.com/taifoon-io/jev-wilson#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taifoon-io/jev-wilson.git"
  },
  "bugs": {
    "url": "https://github.com/taifoon-io/jev-wilson/issues"
  },
  "keywords": [
    "wilson-score",
    "wilson-interval",
    "confidence-interval",
    "premium",
    "insurance",
    "underwriting",
    "reputation",
    "erc-8183",
    "agentic-commerce",
    "ai-agents",
    "jev",
    "typesafe",
    "mcp",
    "gas",
    "fee",
    "calibration",
    "monte-carlo"
  ],
  "type": "module",
  "main": "./dist/wilson.js",
  "types": "./dist/wilson.d.ts",
  "exports": {
    ".": {
      "types": "./dist/wilson.d.ts",
      "default": "./dist/wilson.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./lp": {
      "types": "./dist/lp.d.ts",
      "default": "./dist/lp.js"
    },
    "./gas": {
      "types": "./dist/gas.d.ts",
      "default": "./dist/gas.js"
    },
    "./fee": {
      "types": "./dist/fee.d.ts",
      "default": "./dist/fee.js"
    },
    "./prior": {
      "types": "./dist/prior.d.ts",
      "default": "./dist/prior.js"
    },
    "./calibration": {
      "types": "./dist/calibration.d.ts",
      "default": "./dist/calibration.js"
    },
    "./calibration/*": "./calibration/*",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "jev-wilson": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "calibration",
    "solidity/src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/fix-dts.mjs && chmod +x dist/cli.js",
    "test": "bash scripts/test-all.sh",
    "test:ts": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:py": "python3 -m pytest tests -q -rs",
    "test:sol": "cd solidity && forge test",
    "test:ffi": "cd solidity && WILSON_FFI=1 forge test --ffi",
    "vectors": "node --experimental-strip-types --no-warnings scripts/gen-premium-grid.ts",
    "check": "npm run build && tsc -p tsconfig.test.json && npm test",
    "prepack": "npm run build",
    "vectors:fee": "node --experimental-strip-types --no-warnings scripts/gen-fee-grid.ts",
    "calibrate": "node --experimental-strip-types --no-warnings src/cli.ts calibrate",
    "calibration:check": "node --experimental-strip-types --no-warnings src/cli.ts calibration check"
  },
  "peerDependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "@typesafe-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@taifoon/jev": "^0.2.13",
    "@taifoon/n8n-nodes-typesafe": "^2.0.4"
  }
}
